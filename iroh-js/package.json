{
  "name": "@strangecyan/iroh",
  "author": "number0",
  "description": "A toolkit for building distributed applications. A fork of @number0/iroh whose incoming connections can be accepted without NAT traversal (Incoming.acceptWithoutNatTraversal).",
  "keywords": [
    "iroh",
    "distributed",
    "applications",
    "p2p",
    "peer-to-peer",
    "networking",
    "network",
    "protocol"
  ],
  "version": "1.1.0-relayed.1",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">= 20.3.0"
  },
  "napi": {
    "binaryName": "iroh",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/changesbyjames/iroh-ffi.git",
    "directory": "iroh-js"
  },
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@napi-rs/cli": "^3.7.2",
    "typedoc": "^0.28.20",
    "typescript": "~5.8.3"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --strip",
    "build:debug": "napi build --platform",
    "docs": "typedoc",
    "prepublishOnly": "napi pre-publish -t npm --no-gh-release",
    "test": "node --test test/*.mjs",
    "version": "napi version"
  },
  "packageManager": "yarn@1.22.22"
}
